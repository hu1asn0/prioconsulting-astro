---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import FAQ from '../components/FAQ.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { SITE_URL } from '../data/schema';

const faqItems = [
  {
    question: 'Milyen projektekhez ajánlott a tanácsadás?',
    answer: 'SAP, CRM, ERP migrációk, digitális transzformációs projektek, IT infrastruktúra fejlesztések és bármilyen nagyvállalati IT projekt, ahol tapasztalt projektmenedzsmentre van szükség.',
  },
  {
    question: 'Hogyan zajlik az együttműködés?',
    answer: 'Első lépésként egy ingyenes konzultáción feltérképezzük az igényeit. Ezután egy részletes projekttervvel térünk vissza, amely tartalmazza az időkereteket, mérföldköveket és az árajánlatot.',
  },
  {
    question: 'Mekkora projektekhez érdemes külső PM-et bevonni?',
    answer: 'Általában 3 hónapnál hosszabb, több csapatot érintő, vagy stratégiai fontosságú projekteknél érdemes tapasztalt külső projektmenedzsert bevonni. Ez biztosítja a független, objektív vezetést.',
  },
  {
    question: 'Milyen iparágakban van tapasztalatuk?',
    answer: 'Több mint 15 év tapasztalattal rendelkezünk az energia, pénzügy, gyártás és szolgáltató szektorban. Ügyfeleink között nagyvállalatok és KKV-k egyaránt megtalálhatók.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE_URL}/#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

// SVG icons for service cards (Lucide icons)
const iconPM = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>';
const iconAuto = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>';
const iconMentor = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>';
---

<Layout
  title="Prio Consulting | Stratégiai IT Projekt Menedzsment"
  description="Prio Consulting — Stratégiai IT Projekt Menedzsment és tanácsadás. 15+ év tapasztalat nagyvállalati IT projektek vezetésében."
  lang="hu"
  pageSchema={faqSchema}
>
  <Hero
    title="Stratégiai IT Projekt Menedzsment"
    subtitle="Tapasztalt IT projektmenedzsment tanácsadás, amely biztosítja projektjei sikeres megvalósítását — időben, költséghatáron belül és az elvárt minőségben."
    ctaText="Kérjen árajánlatot"
    ctaLink="/kapcsolat/"
  />

  <!-- Services Section -->
  <section class="section section-light">
    <div class="container">
      <h2 class="text-center section-heading">Szolgáltatásaink</h2>
      <p class="section-subtitle text-center">Átfogó IT projektmenedzsment megoldások vállalata számára</p>
      <div class="services-grid">
        <ServiceCard
          title="IT Projekt Menedzsment"
          description="SAP, CRM és ERP migrációk professzionális vezetése. Agilis és vízesés módszertanok, kockázatkezelés, erőforrás-tervezés."
          icon={iconPM}
        />
        <ServiceCard
          title="Automatizálás"
          description="Üzleti folyamatok automatizálása, workflow optimalizálás, AI integrációk tervezése és megvalósítása."
          icon={iconAuto}
        />
        <ServiceCard
          title="Mentoring"
          description="IT projektmenedzserek személyre szabott coaching programja. Vezetői kompetenciák, stakeholder menedzsment."
          icon={iconMentor}
        />
      </div>
    </div>
  </section>

  <!-- Applied AI layer -->
  <section class="section section-surface">
    <div class="container applied-ai-band">
      <span class="applied-ai-eyebrow">Applied AI réteg</span>
      <h2>Mesterséges intelligencia projektfegyelemmel</h2>
      <p>
        A klasszikus projektmenedzsment mellett külön szakterületként foglalkozom az AI bevezetésével
        vállalati folyamatokba: felmérés, kísérleti szakasz, éles üzem, átadás. A módszer mögött nem
        bemutatók állnak, hanem saját szerveren futó, ütemezett AI-rendszerek.
      </p>
      <a href="/applied-ai/" class="btn-primary">
        Applied AI szolgáltatás
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="section section-dark stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item" data-stat>
          <div class="stat-value"><span class="stat-number" data-target="15">0</span><span class="stat-suffix">+</span></div>
          <span class="stat-label">év tapasztalat</span>
        </div>
        <div class="stat-item" data-stat>
          <div class="stat-value"><span class="stat-number" data-target="50">0</span><span class="stat-suffix">+</span></div>
          <span class="stat-label">sikeres projekt</span>
        </div>
        <div class="stat-item" data-stat>
          <div class="stat-value"><span class="stat-number" data-target="100">0</span><span class="stat-suffix">%</span></div>
          <span class="stat-label">ügyfél-elégedettség</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial Section -->
  <section class="section section-surface">
    <div class="container">
      <h2 class="text-center section-heading">Amit ügyfeleink mondanak</h2>
      <p class="section-subtitle text-center">Partnereink visszajelzései az együttműködésről</p>
      <Testimonial
        items={[
          {
            quote: "Thanks for everything, I really liked working with you: even if you were an IT project manager, you fully captured the most important business points of the project, did not get lost in technical details, still you wanted to understand the main targets of the project and drive the whole story to the right way in line with the key stakeholders' expectations. You really stood out considering my previous experiences.",
            company: "MOL Hungary Ltd.",
            person: "Máté Gerebenics",
          },
        ]}
      />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-light">
    <div class="container">
      <h2 class="text-center section-heading">Gyakran Ismételt Kérdések</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-dark cta-section">
    <div class="container text-center">
      <h2>Készen áll a következő lépésre?</h2>
      <p class="cta-description">Vegye fel velünk a kapcsolatot, és beszélgessünk projektje igényeiről.</p>
      <a href="/kapcsolat/" class="btn-primary cta-button">
        Kapcsolatfelvétel
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <NewsletterSignup lang="hu" />
</Layout>

<style>
  .section-heading {
    margin-bottom: var(--space-sm);
  }

  .section-subtitle {
    color: var(--color-secondary);
    margin-bottom: var(--space-2xl);
    font-size: 1.125rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
  }

  /* Applied AI band */
  .applied-ai-band {
    max-width: 760px;
    text-align: center;
  }

  .applied-ai-eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cta);
    margin-bottom: var(--space-sm);
  }

  .applied-ai-band h2 {
    margin-bottom: var(--space-md);
  }

  .applied-ai-band p {
    color: var(--color-secondary);
    margin-bottom: var(--space-xl);
    line-height: 1.8;
  }

  /* Stats */
  .stats-section {
    text-align: center;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-2xl);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .stat-value {
    display: flex;
    align-items: baseline;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-cta);
    line-height: 1;
  }

  .stat-suffix {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-cta);
    line-height: 1;
  }

  .stat-label {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  /* CTA Section */
  .cta-section h2 {
    margin-bottom: var(--space-md);
  }

  .cta-description {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: var(--space-xl);
    font-size: 1.125rem;
    max-width: 500px;
    margin-inline: auto;
  }

  .cta-button {
    font-size: 1.0625rem;
    padding: 14px 32px;
  }
</style>

<script>
  // Animated counter with IntersectionObserver
  function animateCounters() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const numberEl = entry.target.querySelector('.stat-number') as HTMLElement;
            if (!numberEl) return;
            const target = parseInt(numberEl.dataset.target || '0', 10);
            const duration = 2000;
            const startTime = performance.now();

            function update(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Ease out cubic
              const eased = 1 - Math.pow(1 - progress, 3);
              numberEl.textContent = Math.round(target * eased).toString();
              if (progress < 1) {
                requestAnimationFrame(update);
              }
            }

            requestAnimationFrame(update);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    document.querySelectorAll('[data-stat]').forEach((el) => observer.observe(el));
  }

  // Check for reduced motion preference
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    animateCounters();
  } else {
    // Show final values immediately
    document.querySelectorAll('.stat-number').forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.textContent = htmlEl.dataset.target || '0';
    });
  }
</script>
