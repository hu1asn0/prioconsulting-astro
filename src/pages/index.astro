---
import Layout from '../layouts/Layout.astro';
import InstructionHome, { type HomeCopy } from '../components/InstructionHome.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { SITE_URL } from '../data/schema';

const faqItems = [
  {
    question: 'Milyen projektekhez ajánlott a tanácsadás?',
    answer: 'SAP, CRM, ERP migrációk, digitális transzformációs projektek, IT infrastruktúra fejlesztések és bármilyen nagyvállalati IT projekt, ahol tapasztalt projektmenedzsmentre van szükség.',
  },
  {
    question: 'Hogyan zajlik az együttműködés?',
    answer: 'Első lépésként egy ingyenes konzultáción feltérképezzük az igényeit. Ezután egy részletes projekttervvel térünk vissza, amely tartalmazza az időkereteket, mérföldköveket és az árajánlatot.',
  },
  {
    question: 'Mekkora projektekhez érdemes külső PM-et bevonni?',
    answer: 'Általában 3 hónapnál hosszabb, több csapatot érintő, vagy stratégiai fontosságú projekteknél érdemes tapasztalt külső projektmenedzsert bevonni. Ez biztosítja a független, objektív irányítást.',
  },
  {
    question: 'Milyen iparágakban van tapasztalatuk?',
    answer: 'Több mint 15 év tapasztalattal rendelkezünk az energia, pénzügy, gyártás és szolgáltató szektorban. Ügyfeleink között nagyvállalatok és KKV-k egyaránt megtalálhatók.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE_URL}/#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const copy: HomeCopy = {
  lang: 'hu',
  stepWord: 'lépés',
  hero: {
    title: 'A programja már áll. Egy darab hiányzik.',
    lead: 'Applied AI IT PM: az a darab, amely a mesterséges intelligenciát a meglévő vállalati programba illeszti — tizenöt év SAP-, energetikai és banki programvezetéssel, és saját, élesben futó AI-rendszerekkel.',
    ctaLabel: 'Kérjen felmérést',
    ctaHref: '/kapcsolat/',
    drawingAlt: 'Rajz: a vállalati program kockái halványan (SAP IS-U, ERP, CRM, adattárház), egy üres hellyel; a piros „Applied AI IT PM” kocka nyíl mentén a helyére ereszkedik.',
  },
  callout: { name: 'Simon András', role: 'Applied AI IT PM', years: '15 év', company: 'Prio Consulting Kft.', scaleLabel: '1:1', partsLabel: 'Ebben a készletben' },
  programBlocks: ['SAP IS-U', 'ERP', 'CRM', 'Adattárház'],
  pieceLabel: 'Applied AI IT PM',
  stepsHeading: 'Így illeszkedik a helyére',
  steps: [
    { title: 'Felmérés', label: 'Felmérés', time: '2–3 hét', body: 'Végigjárjuk a szóba jöhető folyamatokat, és megnézzük, hol van valódi ismétlődő teher. Rögzítjük a mai időráfordítást és hibaarányt, feltérképezzük az adatforrásokat, és tisztázzuk az adatvédelmi kereteket. A kimenet egy rangsorolt lista arról, mit érdemes elsőként megcsinálni, és mit nem érdemes egyáltalán.' },
    { title: 'Pilot', label: 'Pilot', time: '6–8 hét', body: 'Egyetlen folyamatra épül a legkisebb működő megoldás, valódi adaton, valódi felhasználókkal. Elkészül a kiértékelő készlet, és mérjük a válaszminőséget, a futásidőt és a költséget. A kimenet egy futó rendszer és egy döntési anyag: számokkal alátámasztva megy-e élesbe.' },
    { title: 'Éles üzem', label: 'Éles üzem', time: '8–12 hét', body: 'A pilotból üzemeltethető rendszer lesz: integráció a meglévő rendszerekhez, jogosultságok, naplózás, mentés, monitoring és riasztások. Megírjuk az üzemeltetési leírást, és felkészítjük a felhasználókat. Itt derül ki, hogy a folyamat körüli munkautasításokat is hozzá kell igazítani.' },
    { title: 'Átadás', label: 'Átadás', time: '4–6 hét', body: 'Az Önök csapata átveszi az üzemeltetést, én pedig egy ideig még mögötte állok. Közös hibakezelés, a kiértékelő készlet karbantartásának betanítása, a költségkeret gazdájának kijelölése. A cél az, hogy a rendszer akkor is működjön, amikor én már nem vagyok a projektben.' },
  ],
  inventory: {
    heading: 'Alkatrészek a készletben',
    note: 'Amit a programjába be tudok építeni.',
    items: [
      { title: 'IT projektmenedzsment', body: 'SAP, CRM és ERP migrációk professzionális vezetése. Agilis és vízesés módszertanok, kockázatkezelés, erőforrás-tervezés.', href: '/szolgaltatasok/', linkLabel: 'Szolgáltatások' },
      { title: 'Applied AI', body: 'AI bevezetése vállalati folyamatokba projektfegyelemmel: felmérés, pilot, éles üzem, átadás. A módszer mögött nem bemutatók állnak, hanem saját szerveren futó, ütemezett AI-rendszerek.', href: '/applied-ai/', linkLabel: 'Applied AI szolgáltatás' },
      { title: 'Automatizálás', body: 'Üzleti folyamatok automatizálása, workflow-optimalizálás, AI-integrációk tervezése és megvalósítása.' },
      { title: 'Mentoring', body: 'IT-projektmenedzserek személyre szabott coaching programja. Vezetői kompetenciák, stakeholder-menedzsment.' },
    ],
  },
  builds: {
    heading: 'Ebből épült',
    note: 'Programok, amelyekben dolgoztam.',
    groups: [
      { sector: 'Energetika', names: ['MVM', 'E.ON', 'OPUS TITÁSZ', 'MOL'] },
      { sector: 'Pénzügy és biztosítás', names: ['Allianz', 'PPF'] },
      { sector: 'Ipar és gyártás', names: ['Beck&Pollitzer', 'Kienle+Spiess', 'FlexLink', 'SANYO'] },
    ],
  },
  quote: {
    heading: 'Egy emlékezetes megjegyzés a hátsó borítóról',
    items: [
      {
        quote: 'Thanks for everything, I really liked working with you: even if you were an IT project manager, you fully captured the most important business points of the project, did not get lost in technical details, still you wanted to understand the main targets of the project and drive the whole story to the right way in line with the key stakeholders\' expectations. You really stood out considering my previous experiences.',
        company: 'MOL Hungary Ltd.',
        person: 'Máté Gerebenics',
      },
    ],
  },
  faq: { heading: 'Gyakori kérdések', items: faqItems },
  faqNote: 'Jegyzetek az útmutató végén — kattintásra nyílnak.',
  closing: {
    title: 'Kezdjük az 1. lépéssel',
    body: 'Egy felmérésen kiderül, hol illeszkedik az AI a folyamataiba — és hol nem érdemes erőltetni.',
    ctaLabel: 'Kérjen felmérést',
    ctaHref: '/kapcsolat/',
  },
};
---

<Layout
  title="Prio Consulting | Applied AI IT projektmenedzsment"
  description="Prio Consulting — Applied AI IT projektmenedzsment: mesterséges intelligencia bevezetése vállalati programokba, 15 év SAP-, energetikai és banki programvezetéssel."
  lang="hu"
  pageSchema={faqSchema}
>
  <InstructionHome copy={copy} />
  <NewsletterSignup lang="hu" />
</Layout>
