---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import FAQ from '../components/FAQ.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

const faqItems = [
  {
    question: 'Milyen projektekhez ajanlott a tanacsadas?',
    answer: 'SAP, CRM, ERP migraciok, digitalis transzformacios projektek, IT infrastruktura fejlesztesek es barmilyen nagyvallalati IT projekt, ahol tapasztalt projekt menedzsmentre van szukseg.',
  },
  {
    question: 'Hogyan zajlik az egyuttmukodes?',
    answer: 'Elso lepeskent egy ingyenes konzultacion felterkepezzuk az igenyeit. Ezutan egy reszletes projekttervvel terunk vissza, amely tartalmazza az idokereteket, merfoldkoveket es az arajanlatot.',
  },
  {
    question: 'Mekkora projektekhez erdemes kulso PM-et bevonni?',
    answer: 'Altalaban 3 honapnal hosszabb, tobb csapatot erinto, vagy strategiai fontossagu projekteknel erdemes tapasztalt kulso projekt menedzsert bevonni. Ez biztositja a fuggetlen, objektiv vezetest.',
  },
  {
    question: 'Milyen iparagakban van tapasztalatuk?',
    answer: 'Tobb mint 15 ev tapasztalattal rendelkezunk energia, penzugy, gyartas es szolgaltato szektorban. Ugyfeleink kozott nagyvallalatok es KKV-k egyarant megtalalhatok.',
  },
];

// SVG icons for service cards (Lucide icons)
const iconPM = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>';
const iconAuto = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>';
const iconMentor = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>';
---

<Layout
  title="Prio Consulting | Strategiai IT Projekt Menedzsment"
  description="Prio Consulting — Strategiai IT Projekt Menedzsment es tanacsadas. 15+ ev tapasztalat nagyvallalati IT projektek vezeteseben."
  lang="hu"
>
  <Hero
    title="Strategiai IT Projekt Menedzsment"
    subtitle="Tapasztalt IT projekt menedzsment tanacsadas, amely biztositja projektjei sikeres megvalositasat — idoben, koltseghatarony belul es az elvart minosegben."
    ctaText="Kerjen ajanlatot"
    ctaLink="/kapcsolat/"
  />

  <!-- Services Section -->
  <section class="section section-light">
    <div class="container">
      <h2 class="text-center section-heading">Szolgaltatasaink</h2>
      <p class="section-subtitle text-center">Atfogo IT projekt menedzsment megoldasok vallalata szamara</p>
      <div class="services-grid">
        <ServiceCard
          title="IT Projekt Menedzsment"
          description="SAP, CRM es ERP migraciok professzionalis vezetese. Agilis es vizeses modszertanok, kockazatkezeles, eroforras-tervezes."
          icon={iconPM}
        />
        <ServiceCard
          title="Automatizalas"
          description="Uzleti folyamatok automatizalasa, workflow optimalizalas, AI integraciok tervezese es megvalositasa."
          icon={iconAuto}
        />
        <ServiceCard
          title="Mentoring"
          description="IT projekt menedzserek szemelyre szabott coaching programja. Vezetoi kompetenciak, stakeholder menedzsment."
          icon={iconMentor}
        />
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="section section-dark stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item" data-stat>
          <span class="stat-number" data-target="15">0</span><span class="stat-suffix">+</span>
          <span class="stat-label">ev tapasztalat</span>
        </div>
        <div class="stat-item" data-stat>
          <span class="stat-number" data-target="50">0</span><span class="stat-suffix">+</span>
          <span class="stat-label">sikeres projekt</span>
        </div>
        <div class="stat-item" data-stat>
          <span class="stat-number" data-target="100">0</span><span class="stat-suffix">%</span>
          <span class="stat-label">ugyfel-elegedettseg</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial Section -->
  <section class="section section-surface">
    <div class="container">
      <h2 class="text-center section-heading">Amit ugyfeleink mondanak</h2>
      <Testimonial
        quote="A Prio Consulting csapata kiemelkedo szakmai tudast es projekt menedzsment kepessegeket hozott a SAP migracios projektunkbe. Az egyuttmukodes gordulekenyen zajlott, es a projekt idoben, a tervezett koltsegvetesen belul valostult meg."
        company="MOL Magyarorszag"
        person="K. Peter"
        role="IT Igazgato"
      />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-light">
    <div class="container">
      <h2 class="text-center section-heading">Gyakran Ismetelt Kerdesek</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-dark cta-section">
    <div class="container text-center">
      <h2>Keszen all a kovetkezo lepesre?</h2>
      <p class="cta-description">Vegye fel velunk a kapcsolatot, es beszelgessunk projektje igenyeirol.</p>
      <a href="/kapcsolat/" class="btn-primary cta-button">
        Kapcsolatfelvetel
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <NewsletterSignup lang="hu" />
</Layout>

<style>
  .section-heading {
    margin-bottom: var(--space-sm);
  }

  .section-subtitle {
    color: var(--color-secondary);
    margin-bottom: var(--space-2xl);
    font-size: 1.125rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
  }

  /* Stats */
  .stats-section {
    text-align: center;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-2xl);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-cta);
    line-height: 1;
  }

  .stat-suffix {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-cta);
    line-height: 1;
  }

  .stat-label {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  /* CTA Section */
  .cta-section h2 {
    margin-bottom: var(--space-md);
  }

  .cta-description {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: var(--space-xl);
    font-size: 1.125rem;
    max-width: 500px;
    margin-inline: auto;
  }

  .cta-button {
    font-size: 1.0625rem;
    padding: 14px 32px;
  }
</style>

<script>
  // Animated counter with IntersectionObserver
  function animateCounters() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const numberEl = entry.target.querySelector('.stat-number') as HTMLElement;
            if (!numberEl) return;
            const target = parseInt(numberEl.dataset.target || '0', 10);
            const duration = 2000;
            const startTime = performance.now();

            function update(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Ease out cubic
              const eased = 1 - Math.pow(1 - progress, 3);
              numberEl.textContent = Math.round(target * eased).toString();
              if (progress < 1) {
                requestAnimationFrame(update);
              }
            }

            requestAnimationFrame(update);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    document.querySelectorAll('[data-stat]').forEach((el) => observer.observe(el));
  }

  // Check for reduced motion preference
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    animateCounters();
  } else {
    // Show final values immediately
    document.querySelectorAll('.stat-number').forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.textContent = htmlEl.dataset.target || '0';
    });
  }
</script>
