---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { SITE_URL } from '../data/schema';

const services = [
  {
    name: 'IT Projekt Menedzsment',
    description: 'Nagyvállalati IT projektek professzionális vezetése a tervezéstől a sikeres bevezetésig. SAP IS-U / ECC / S/4HANA migrációk, CRM és ERP bevezetések, Agilis és vízesés módszertanok.',
    serviceType: 'IT Project Management',
    slug: 'it-projekt-menedzsment',
  },
  {
    name: 'Automatizálási projektek',
    description: 'Üzleti folyamatok automatizálása workflow, AI integrációk és riporting területén. Időt és költséget takarít meg vállalata számára.',
    serviceType: 'Business Process Automation',
    slug: 'automatizalas',
  },
  {
    name: 'Mentoring és Coaching',
    description: 'IT projektmenedzserek személyre szabott fejlesztése: egyéni coaching, stakeholder menedzsment, csapat mentorálás.',
    serviceType: 'IT Project Management Coaching',
    slug: 'mentoring',
  },
];

const servicesSchema = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE_URL}/szolgaltatasok/#${s.slug}`,
  name: s.name,
  description: s.description,
  serviceType: s.serviceType,
  provider: { '@id': `${SITE_URL}#business` },
  areaServed: { '@type': 'Country', name: 'Hungary' },
  url: `${SITE_URL}/szolgaltatasok/`,
}));
---

<Layout
  title="Szolgáltatások | Prio Consulting"
  description="IT Projekt Menedzsment, Automatizálás és Mentoring szolgáltatások. Tapasztalt tanácsadás nagyvállalati projektekhez."
  lang="hu"
  pageSchema={servicesSchema}
>
  <Hero
    title="Szolgáltatásaink"
    subtitle="Átfogó IT-projektmenedzsment megoldások, amelyek segítik az Ön vállalatának digitális transzformációját."
  />

  <!-- IT Project Management -->
  <section class="section section-light">
    <div class="container service-detail">
      <div class="service-detail-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </div>
      <h2>IT Projekt Menedzsment</h2>
      <p class="service-detail-lead">Nagyvállalati IT projektek professzionális vezetése a tervezéstől a sikeres bevezetésig.</p>
      <div class="service-features">
        <div class="feature">
          <h3>SAP migrációk</h3>
          <p>SAP S/4HANA migrációs projektek teljes életciklus-menedzsmentje. Kockázatkezelés, időterv-optimalizálás, stakeholder kommunikáció.</p>
        </div>
        <div class="feature">
          <h3>CRM bevezetés</h3>
          <p>CRM rendszerek bevezetésének koordinálása. Az üzleti igények felmérésétől a felhasználói átadásig.</p>
        </div>
        <div class="feature">
          <h3>ERP projektek</h3>
          <p>Vállalati erőforrás-tervező rendszerek bevezetésének és upgrade-jének menedzselése. Folyamat-optimalizálás, change management.</p>
        </div>
        <div class="feature">
          <h3>Agilis és vízesés módszertanok</h3>
          <p>Rugalmas megközelítés: tiszta Agile, Waterfall, vagy hibrid módszertanok alkalmazása a projekt jellegének megfelelően.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Automation -->
  <section class="section section-surface">
    <div class="container service-detail">
      <div class="service-detail-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
      </div>
      <h2>Automatizálási projektek</h2>
      <p class="service-detail-lead">Üzleti folyamatok automatizálása, amely időt és költséget takarít meg vállalata számára.</p>
      <div class="service-features">
        <div class="feature">
          <h3>Workflow automatizálás</h3>
          <p>Ismétlődő feladatok azonosítása és automatizálása. Integráció meglévő rendszerekkel, API-k és iPaaS megoldások.</p>
        </div>
        <div class="feature">
          <h3>AI integrációk</h3>
          <p>Mesterséges intelligencia megoldások tervezése és integráció meglévő üzleti folyamatokba. Chatbotok, dokumentumfeldolgozás, prediktív analitika.</p>
        </div>
        <div class="feature">
          <h3>Riporting automatizálás</h3>
          <p>Automatikus riportgenerálás, dashboardok és monitoring rendszerek kiépítése. Adatalapú döntéstámogatás.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mentoring -->
  <section class="section section-light">
    <div class="container service-detail">
      <div class="service-detail-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <h2>Mentoring és Coaching</h2>
      <p class="service-detail-lead">IT projektmenedzserek személyre szabott fejlesztése és támogatása.</p>
      <div class="service-features">
        <div class="feature">
          <h3>Egyéni coaching</h3>
          <p>Személyre szabott coaching program IT projektmenedzserek számára. Vezetői kompetenciák, időgazdálkodás, konfliktuskezelés.</p>
        </div>
        <div class="feature">
          <h3>Stakeholder menedzsment</h3>
          <p>Hatékony stakeholder kommunikáció és elváráskezelés technikák elsajátítása. Tapasztalati workshopok.</p>
        </div>
        <div class="feature">
          <h3>Csapat mentorálás</h3>
          <p>Projektcsapatok fejlesztése, csapatépítés, agilis ceremóniákra felkészítés. Retrospektív facilitálás.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Applied AI pillar link -->
  <section class="section section-surface">
    <div class="container service-detail">
      <div class="service-detail-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v1a3 3 0 0 0-3 3v1a3 3 0 0 0 0 6v1a3 3 0 0 0 3 3v1a3 3 0 0 0 6 0v-1a3 3 0 0 0 3-3v-1a3 3 0 0 0 0-6V9a3 3 0 0 0-3-3V5a3 3 0 0 0-3-3Z"/><path d="M12 5v14"/></svg>
      </div>
      <h2>Applied AI</h2>
      <p class="service-detail-lead">Külön szakterület: mesterséges intelligencia bevezetése vállalati folyamatokba, projektmenedzsment-fegyelemmel.</p>
      <p class="applied-ai-teaser">
        Dokumentumfeldolgozás és belső keresés, automatizált riportálás, AI-rendszerek monitoringja,
        valamint a saját szerveres és felhős futtatás közötti döntés. A munka négy, külön dönthető
        szakaszban halad: felmérés, kísérleti szakasz, éles üzem, átadás. A részletes bemutatót
        önálló oldalon olvashatja.
      </p>
      <a href="/applied-ai/" class="btn-primary">
        Applied AI részletesen
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark cta-section">
    <div class="container text-center">
      <h2>Érdekli valamelyik szolgáltatásunk?</h2>
      <p class="cta-desc">Vegye fel velünk a kapcsolatot egy ingyenes konzultációért.</p>
      <a href="/kapcsolat/" class="btn-primary">
        Kapcsolatfelvétel
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  .service-detail {
    max-width: 800px;
  }

  .service-detail-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(202, 138, 4, 0.1);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-cta);
  }

  .service-detail h2 {
    margin-bottom: var(--space-md);
  }

  .service-detail-lead {
    font-size: 1.25rem;
    color: var(--color-secondary);
    margin-bottom: var(--space-2xl);
    line-height: 1.6;
  }

  .service-features {
    display: grid;
    gap: var(--space-xl);
  }

  .feature h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .feature p {
    color: var(--color-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  .applied-ai-teaser {
    color: var(--color-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .cta-section h2 {
    margin-bottom: var(--space-md);
  }

  .cta-desc {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: var(--space-xl);
    font-size: 1.125rem;
  }
</style>
