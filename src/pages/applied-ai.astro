---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_URL } from '../data/schema';

const faqItems = [
  {
    question: 'Mennyi idő, mire az első eredmény látszik?',
    answer: 'A felmérés 2–3 hét, a pilot ezután 6–8 hét. A pilot végén nem prezentáció van, hanem egy futó rendszer és egy mérési jegyzőkönyv, amiből eldönthető, megy-e élesbe. Ha a felmérés azt hozza ki, hogy a folyamat AI nélkül is javítható, ezt megmondom, és ott le is állunk.',
  },
  {
    question: 'Muszáj felhőbe vinni az adatainkat?',
    answer: 'Nem. A nyílt súlyú modellek ma már saját szerveren is elfutnak, és sok belső feladatnál elég jók. A felhős modellek jellemzően pontosabbak és nulla üzemeltetést igényelnek. A választás adatérzékenységi és költségkérdés, a felmérésben döntjük el, nem előre.',
  },
  {
    question: 'Nálunk nincs AI-hoz értő ember. Ez akadály?',
    answer: 'Az üzemeltetéshez nem kell AI-szakértő, egy rendszergazdai szintű csapat elég. Ami viszont kell: egy üzleti oldali gazdája a folyamatnak, aki el tudja dönteni, hogy egy adott válasz jó-e vagy sem. Ő az, aki a kiértékelő készletet validálja, és nélküle nincs mérhető minőség.',
  },
  {
    question: 'Mibe kerül ez, és min múlik a költség?',
    answer: 'A modellhasználat a legtöbb belső folyamatnál a kisebb tétel. A költség java a felmérésben, az adat-előkészítésben és az integrációban van, vagyis emberi munkában. Ezért adok szakaszonként külön árajánlatot: a felmérés után Önök már tudják, mibe kerül a pilot, a pilot után pedig azt, mibe kerül az éles üzem.',
  },
  {
    question: 'Mi történik, ha a rendszer téves választ ad?',
    answer: 'Az, hogy néha téved, nem hiba, hanem a technológia tulajdonsága. A kérdés az, hogy a folyamat elviseli-e. Ezért minden éles rendszernél forrásmegjelölés, mérhető hibaarány és emberi jóváhagyási pont épül be ott, ahol a tévedés drága. Amelyik folyamat ezt nem bírja el, azt nem is automatizáljuk.',
  },
  {
    question: 'Fejlesztőcsapatot is hoz, vagy csak vezeti a projektet?',
    answer: 'Elsősorban projektvezetést vállalok és architektúra-döntéseket hozok, a megvalósításba pedig az Önök csapata vagy egy behozott fejlesztő kapcsolódik be. Az én szerepem, hogy a döntések megalapozottak legyenek, a szállítás követhető maradjon, és a végén az Önök csapatához kerüljön a rendszer.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE_URL}/applied-ai/#service`,
  name: 'Applied AI projektmenedzsment',
  serviceType: 'Applied AI Project Management',
  description:
    'Mesterséges intelligencia bevezetése vállalati folyamatokba projektmenedzsment-fegyelemmel: felmérés, pilot, éles üzem, átadás. Dokumentumfeldolgozás és keresés (RAG), automatizált riportálás, monitoring, on-premise és felhős üzemeltetés.',
  provider: { '@id': `${SITE_URL}#business` },
  areaServed: [
    { '@type': 'Country', name: 'Hungary' },
    { '@type': 'AdministrativeArea', name: 'Európai Unió' },
  ],
  url: `${SITE_URL}/applied-ai/`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Applied AI képességterületek',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Dokumentumfeldolgozás és belső keresés (RAG)',
          description:
            'Saját dokumentumbázisra épülő kérdés-válasz és keresés forrásmegjelöléssel, jogosultságkezeléssel és mérhető válaszminőséggel.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Automatizált riportálás és döntéstámogatás',
          description:
            'Rendszeres riportok gépi előállítása több adatforrásból, természetes nyelvű összefoglalóval és ütemezett kiküldéssel.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'AI rendszerek monitoringja és üzemeltetése',
          description:
            'Futásidő, költség és válaszminőség folyamatos mérése, riasztások, kiértékelő készletek karbantartása.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'On-premise és felhős architektúra-döntés',
          description:
            'Saját szerveres és felhős modellfuttatás összehasonlítása adatérzékenység, költség és üzemeltetési teher szerint.',
        },
      },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE_URL}/applied-ai/#faq`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="Applied AI: mesterséges intelligencia projektfegyelemmel | Prio Consulting"
  description="AI bevezetése vállalati folyamatokba tizenöt év IT-projektmenedzsment-tapasztalattal. Felmérés, pilot, éles üzem, átadás. Dokumentumfeldolgozás, riportautomatizálás, saját szerver vagy felhő."
  lang="hu"
  hreflangAlternate={false}
  pageSchema={[serviceSchema, faqSchema]}
>
  <Hero
    title="Applied AI"
    subtitle="Mesterséges intelligencia a vállalati működésben, projektmenedzsment-fegyelemmel: felméréstől az éles üzemen át az átadásig."
    ctaText="Kérjen felmérést"
    ctaLink="/kapcsolat/"
  />

  <!-- 1. Mit jelent az applied AI -->
  <section class="section section-light">
    <div class="container pillar-content">
      <h2>Mit jelent az „applied AI” a gyakorlatban</h2>
      <p>
        Az alkalmazott mesterséges intelligencia („applied AI”) nem kutatási terület és nem
        modellfejlesztés. Arról szól, hogy egy meglévő nyelvi modellt beillesztünk egy konkrét
        munkafolyamatba úgy, hogy a folyamat mérhetően gyorsabb, olcsóbb vagy pontosabb legyen.
        A modellt nem mi tanítjuk: kész modellel dolgozunk, és azt építjük köré, amitől a modell
        használhatóvá válik.
      </p>
      <p>
        A munka java része ezért nem a modellnél van. Ott van, ahol egy IT-projektben mindig is
        lenni szokott: az adatok minőségénél, a jogosultságoknál, az integrációnál, a tesztelésnél
        és az üzemeltetésnél. Egy belső dokumentumkereső esetében a modell kiválasztása néhány nap
        munka, a jogosultsági szabályok tisztázása viszont hetekbe telhet. Az arány ritkán fordul meg.
      </p>
      <p>
        Ez a szemlélet magyarázza, miért ugyanazok a szabályok érvényesek rá, mint egy SAP-bevezetésre
        vagy egy adatmigrációra. Kell hozzá hatókör, mérföldkövek, elfogadási kritérium, tesztterv,
        felelős gazda az üzleti oldalon és átadási terv. Ha ezek hiányoznak, a technológia újdonsága
        semmit nem ment meg.
      </p>

      <div class="contrast-grid">
        <div class="contrast-card contrast-no">
          <h3>Amiről nem szól</h3>
          <ul>
            <li>Saját alapmodell tanítása a nulláról</li>
            <li>Mindent átfogó „AI-stratégia” konkrét folyamat nélkül</li>
            <li>Chatbot a honlapra, mert a versenytársnak is van</li>
            <li>Olyan bemutató, ami válogatott példákon működik, éles adaton nem</li>
          </ul>
        </div>
        <div class="contrast-card contrast-yes">
          <h3>Amiről szól</h3>
          <ul>
            <li>Egy fájdalmas, ismétlődő folyamat kiválasztása és megmérése</li>
            <li>A legkisebb működő megoldás, ami ezt a folyamatot javítja</li>
            <li>Számokkal alátámasztott döntés arról, megy-e élesbe</li>
            <li>Üzemeltethető rendszer, amit az Önök csapata is ért</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Miért akad el a legtöbb pilot -->
  <section class="section section-surface">
    <div class="container pillar-content">
      <h2>Miért akad el a legtöbb AI-pilot</h2>
      <p>
        A kísérleti szakasz („pilot”) ritkán technológiai okból hal el. Sokkal gyakoribb, hogy a
        bemutató jól sikerül, aztán senki nem tudja megmondani, mi legyen a következő lépés. Öt
        visszatérő mintát látok, és mindegyikre van bevált projektmenedzsment-válasz.
      </p>

      <div class="failure-list">
        <div class="failure-item">
          <h3>1. Nincs mihez mérni</h3>
          <p>
            Ha a pilot indulásakor nem tudjuk, hogy egy ajánlatkérés feldolgozása ma hány percbe és
            hány emberi kézbe kerül, akkor a végén sem lesz mihez hasonlítani. A lelkesedés nem
            mérőszám.
          </p>
          <p class="pm-answer">
            <strong>A PM-válasz:</strong> a jelenlegi állapot felmérése az első héten megtörténik,
            és az elfogadási kritériumot még a fejlesztés előtt aláírjuk.
          </p>
        </div>

        <div class="failure-item">
          <h3>2. A bemutató adata nem az éles adat</h3>
          <p>
            A válogatott mintadokumentumokon minden szépen működik. Az éles állományban ott vannak a
            szkennelt szerződések, a rossz minőségű táblázatok, a három különböző elnevezési
            konvenció és a hiányzó mezők.
          </p>
          <p class="pm-answer">
            <strong>A PM-válasz:</strong> a pilot már az első naptól valódi, anonimizált éles adaton
            fut, nem tisztított mintán.
          </p>
        </div>

        <div class="failure-item">
          <h3>3. Nincs kiértékelési módszer</h3>
          <p>
            A nyelvi modell néha téved, és magabiztosan teszi. Ha nincs rögzített kérdés-válasz
            készlet, amin minden változtatás után újramérünk, akkor minden finomítás hitkérdés marad.
            Ez a kiértékelő készlet („eval set”) a projekt legfontosabb és leggyakrabban kihagyott
            eleme.
          </p>
          <p class="pm-answer">
            <strong>A PM-válasz:</strong> 50 és 200 közötti valós kérdésből álló készletet állítunk
            össze az üzleti gazdával, és minden verzióváltásnál lefuttatjuk.
          </p>
        </div>

        <div class="failure-item">
          <h3>4. A biztonsági és jogi kérdéseket a végére hagyják</h3>
          <p>
            Az adatvédelmi tisztviselő vagy az információbiztonsági vezető jellemzően akkor kerül
            képbe, amikor a rendszer már majdnem kész. Ilyenkor derül ki, hogy egy adatkör nem
            hagyhatja el az országot, vagy hogy a jogosultságokat dokumentumszinten kell érvényesíteni.
          </p>
          <p class="pm-answer">
            <strong>A PM-válasz:</strong> az érintettek a felmérés résztvevői, nem a jóváhagyás
            akadályai. Az adatáramlás térképe a pilot előtt elkészül.
          </p>
        </div>

        <div class="failure-item">
          <h3>5. Senki nem veszi át</h3>
          <p>
            A sikeres pilot után a rendszer a tanácsadó gépén marad. Nincs üzemeltetési leírás, nincs
            gazdája a költségkeretnek, és fél év múlva már senki nem meri hozzányúlni.
          </p>
          <p class="pm-answer">
            <strong>A PM-válasz:</strong> az átadás nem záró esemény, hanem az első naptól tervezett
            szakasz, dokumentációval és közös üzemeltetési időszakkal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Hogyan dolgozom -->
  <section class="section section-light">
    <div class="container pillar-content">
      <h2>Hogyan dolgozom: négy szakasz</h2>
      <p>
        Minden szakasz külön dönthető és külön árazott. Bármelyik végén ki lehet szállni, és a
        kimenet akkor is az Önöké marad. Ez a felépítés azért fontos, mert így nem kell egyben
        megvenni egy olyan projektet, amiről még nem tudni, megéri-e.
      </p>

      <div class="phase-grid">
        <div class="phase-card">
          <span class="phase-number">01</span>
          <h3>Felmérés</h3>
          <p class="phase-time">2–3 hét</p>
          <p>
            Végigjárjuk a szóba jöhető folyamatokat, és megnézzük, hol van valódi ismétlődő teher.
            Rögzítjük a mai időráfordítást és hibaarányt, feltérképezzük az adatforrásokat, és
            tisztázzuk az adatvédelmi kereteket. A kimenet egy rangsorolt lista arról, mit érdemes
            elsőként megcsinálni, és mit nem érdemes egyáltalán.
          </p>
        </div>

        <div class="phase-card">
          <span class="phase-number">02</span>
          <h3>Pilot</h3>
          <p class="phase-time">6–8 hét</p>
          <p>
            Egyetlen folyamatra épül a legkisebb működő megoldás, valódi adaton, valódi felhasználókkal.
            Elkészül a kiértékelő készlet, és mérjük a válaszminőséget, a futásidőt és a költséget.
            A kimenet egy futó rendszer és egy döntési anyag: számokkal alátámasztva megy-e élesbe.
          </p>
        </div>

        <div class="phase-card">
          <span class="phase-number">03</span>
          <h3>Éles üzem</h3>
          <p class="phase-time">8–12 hét</p>
          <p>
            A pilotból üzemeltethető rendszer lesz: integráció a meglévő rendszerekhez, jogosultságok,
            naplózás, mentés, monitoring és riasztások. Megírjuk az üzemeltetési leírást, és
            felkészítjük a felhasználókat. Itt derül ki, hogy a folyamat körüli munkautasításokat is
            hozzá kell igazítani.
          </p>
        </div>

        <div class="phase-card">
          <span class="phase-number">04</span>
          <h3>Átadás</h3>
          <p class="phase-time">4–6 hét</p>
          <p>
            Az Önök csapata átveszi az üzemeltetést, én pedig egy ideig még mögötte állok. Közös
            hibakezelés, a kiértékelő készlet karbantartásának betanítása, a költségkeret gazdájának
            kijelölése. A cél az, hogy a rendszer akkor is működjön, amikor én már nem vagyok a
            projektben.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Képességterületek -->
  <section class="section section-surface">
    <div class="container pillar-content">
      <h2>Képességterületek</h2>
      <p>
        Négy területen dolgozom rendszeresen. Mindegyiknél az a kérdés, hogy a folyamat elviseli-e a
        gépi tévedést, és hogy hol kell emberi jóváhagyási pontot beépíteni.
      </p>

      <div class="capability-list">
        <div class="capability">
          <h3>Dokumentumfeldolgozás és belső keresés</h3>
          <p>
            A vállalati tudás jellemzően szétszórva él: szerződésekben, szabályzatokban, régi
            levelezésben, projektdokumentációban. A visszakeresésen alapuló válaszadás (angolul
            „retrieval-augmented generation”, röviden RAG) azt jelenti, hogy a modell először
            megkeresi a saját dokumentumaink között a releváns részleteket, és csak azokból fogalmaz
            választ. Ez két dolgot ad: a válasz forrásra hivatkozik, és a modell nem a saját
            emlékezetéből találgat.
          </p>
          <p>
            A tipikus felhasználás egy belső kérdés-válasz felület az ügyfélszolgálatnak, a
            műszaki csapatnak vagy a jogi területnek. A nehézségek nem a modellnél kezdődnek: a
            dokumentumok darabolása, a jogosultságok dokumentumszintű érvényesítése és a
            forrásmegjelölés helyessége viszi el az időt.
          </p>
        </div>

        <div class="capability">
          <h3>Automatizált riportálás és döntéstámogatás</h3>
          <p>
            Sok szervezetben hetente több munkanapnyi kézi munka megy el arra, hogy valaki több
            rendszerből adatot gyűjtsön, összefésülje és értelmezze. Ez a rész jól gépesíthető: az
            adatgyűjtés és a számolás hagyományos kóddal, a szöveges összefoglaló pedig nyelvi
            modellel. A számokat nem a modell állítja elő, csak megfogalmazza, ami mögöttük van.
          </p>
          <p>
            Ez a felállás azért biztonságos, mert a modell nem számol, tehát nincs miben tévednie a
            számadatok szintjén. A riport kiküldése ütemezetten megy oda, ahol a csapat amúgy is
            dolgozik, legyen az levelezés, belső csevegőrendszer vagy irányítópult.
          </p>
        </div>

        <div class="capability">
          <h3>Monitoring és üzemeltetés</h3>
          <p>
            Az AI-rendszer nem attól él, hogy elkészült. A modellek verziói cserélődnek, az árazás
            változik, az adatállomány bővül, és a válaszminőség ettől észrevétlenül romolhat.
            Ezért kell mérni: futásidőt, hibaarányt, költséget, és rendszeres időközönként
            újrafuttatni a kiértékelő készletet.
          </p>
          <p>
            Ugyanez vonatkozik a költségekre. Egy rosszul megírt lekérdezés vagy egy elszabadult
            ismétlés komoly számlát tud okozni, ha nincs rá riasztás. Ez klasszikus üzemeltetési
            feladat, csak a mérőszámok újak.
          </p>
        </div>

        <div class="capability">
          <h3>Saját szerver vagy felhő</h3>
          <p>
            A saját szerveres futtatás („on-premise”) mellett az adatérzékenység szól: az adat nem
            hagyja el a szervezetet, és a költség kiszámítható. A nyílt súlyú modellek, vagyis azok,
            amelyek paraméterei szabadon letölthetők, és így saját gépen is futtathatók, ma már
            elérik azt a szintet, ami sok belső feladathoz elég. Cserébe hardvert, üzemeltetést és
            frissítési fegyelmet kér.
          </p>
          <p>
            A felhős modellek jellemzően pontosabbak, nulla üzemeltetéssel indulnak, viszont
            használatarányos költséggel és külső adatfeldolgozói viszonnyal járnak. A kettő nem
            zárja ki egymást: gyakori, hogy az érzékeny adatkörök saját szerveren maradnak, a
            többi pedig felhőbe kerül. A döntés a felmérés része, nem előfeltevés.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Bizonyíték -->
  <section class="section section-light">
    <div class="container pillar-content">
      <h2>A bizonyíték: saját, futó rendszerek</h2>
      <p>
        Az AI-tanácsadás piacán nehéz megkülönböztetni azt, aki már üzemeltetett ilyen rendszert,
        attól, aki csak beszél róla. Nálam ez ellenőrizhető: több éve saját szerveren futtatok
        AI-alapú rendszereket, ütemezetten, éles adatokon, valódi üzemeltetési következményekkel.
      </p>
      <p class="disclosure">
        Fontos pontosítás: az alább felsorolt rendszerek a saját infrastruktúrámon futnak, és nem
        ügyfélreferenciák. Azt bizonyítják, hogy a technológiát nem bemutatókból ismerem, hanem
        onnan, ahol hétfő reggel meg kell javítani, ha elromlott.
      </p>

      <div class="proof-grid">
        <div class="proof-card">
          <h3>Ütemezett elemzőrendszer piaci adatokra</h3>
          <p>
            Munkanapokon futó rendszer 15 elemű figyelőlistával, több adatforrásból. Egy nyelvi
            modell fordítja üzleti nyelvre a technikai jelzéseket, a riasztások pedig a
            csevegőrendszerbe érkeznek. Ez tanított meg arra, mennyire nem mindegy, hogy egy külső
            adatforrás hibáját a rendszer elnyeli vagy jelzi.
          </p>
        </div>

        <div class="proof-card">
          <h3>Heti piaci felderítő ügynök</h3>
          <p>
