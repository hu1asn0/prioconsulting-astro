---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Testimonial from '../../components/Testimonial.astro';
---

<Layout
  title="About | Prio Consulting"
  description="Andras Simon — IT Project Manager & AI Integrator. 15+ years of experience leading enterprise IT projects."
  lang="en"
>
  <Hero
    title="About"
    subtitle="15+ years of experience successfully leading enterprise IT projects — from the energy sector to the financial industry."
  />

  <!-- Personal Story -->
  <section class="section section-light">
    <div class="container about-content">
      <div class="about-intro">
        <h2>Andras Simon</h2>
        <p class="about-role">IT Project Manager &amp; AI Integrator</p>
        <p>
          With 20+ years of industry and 15+ years of IT project management experience, I lead enterprise
          programs. Throughout my career, I have helped organizations such as MVM Ügyfélszolgálati Zrt.
          (DÉMÁSZ), E.ON Tiszántúli, OPUS TITÁSZ, MOL Nyrt., Allianz Hungária, and PPF Hungária deliver
          complex SAP IS-U migration, cloud transition, carve-out, data migration, and Workday rollout
          programs successfully.
        </p>
        <p>
          I believe that a successful project is not just about technology — it is about people,
          communication, and strategic planning. I take on every project with the goal of creating
          real, measurable business value for my clients.
        </p>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section-surface">
    <div class="container about-content">
      <h2 class="text-center section-heading">My Approach</h2>
      <p class="section-subtitle text-center">The principles I follow in every project</p>
      <div class="approach-grid">
        <div class="approach-card">
          <div class="approach-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3>Structured Planning</h3>
          <p>Every project starts with thorough planning. Risk assessment, milestones, and clear responsibilities defined from day one.</p>
        </div>
        <div class="approach-card">
          <div class="approach-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Transparent Communication</h3>
          <p>Regular status reports, proactive risk signaling, and open dialogue with all stakeholders. No surprises throughout the project.</p>
        </div>
        <div class="approach-card">
          <div class="approach-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
          </div>
          <h3>Technology + Business</h3>
          <p>Technology decisions are always made through the lens of business goals and ROI. AI and automation are tools, not goals in themselves.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="section section-light">
    <div class="container about-content">
      <h2 class="text-center section-heading">Expertise & Competencies</h2>
      <div class="credentials-grid">
        <div class="credential-group">
          <h3>Industry Experience</h3>
          <ul>
            <li>Energy & utilities (MVM, E.ON Tiszántúli, OPUS TITÁSZ, MOL)</li>
            <li>Finance & insurance (Allianz Hungária)</li>
            <li>HR & Workday rollout (PPF Hungária)</li>
            <li>Manufacturing & FMCG (Beck &amp; Pollitzer, Kienle + Spiess, FlexLink Systems, SANYO)</li>
          </ul>
        </div>
        <div class="credential-group">
          <h3>Methodologies</h3>
          <ul>
            <li>Agile (Scrum, Kanban)</li>
            <li>Waterfall</li>
            <li>Hybrid approaches</li>
            <li>PRINCE2, PMI frameworks</li>
          </ul>
        </div>
        <div class="credential-group">
          <h3>Technology Focus</h3>
          <ul>
            <li>SAP IS-U / ECC / S/4HANA migrations and rollouts</li>
            <li>AWS cloud migration</li>
            <li>Data migration and testing (UAT/IT/RT)</li>
            <li>ETRM (ENDUR), GIS/SCADA, Workday HR systems</li>
          </ul>
        </div>
        <div class="credential-group">
          <h3>Leadership Skills</h3>
          <ul>
            <li>Stakeholder management</li>
            <li>Change management</li>
            <li>Risk assessment and mitigation</li>
            <li>Team leadership and mentoring</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section section-surface">
    <div class="container">
      <h2 class="text-center section-heading">What our clients say</h2>
      <Testimonial
        quote="Andras Simon contributed to our project's success not only as a project manager but as a strategic partner. His outstanding communication and problem-solving skills ensured seamless collaboration."
        company="MOL Hungary"
        person="K. Peter"
        role="IT Director"
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark cta-section">
    <div class="container text-center">
      <h2>Let's work together!</h2>
      <p class="cta-description">If you need an experienced IT project manager, let's get in touch.</p>
      <a href="/en/contact/" class="btn-primary cta-button">
        Get in touch
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  .about-content {
    max-width: 900px;
  }

  .section-heading {
    margin-bottom: var(--space-sm);
  }

  .section-subtitle {
    color: var(--color-secondary);
    margin-bottom: var(--space-2xl);
    font-size: 1.125rem;
  }

  /* Intro */
  .about-intro h2 {
    margin-bottom: var(--space-xs);
  }

  .about-role {
    color: var(--color-cta);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    margin-bottom: var(--space-xl);
  }

  .about-intro p {
    color: var(--color-secondary);
    margin-bottom: var(--space-lg);
    line-height: 1.8;
  }

  /* Approach */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
  }

  .approach-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base);
  }

  .approach-card:hover {
    box-shadow: var(--shadow-md);
  }

  .approach-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(202, 138, 4, 0.1);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-cta);
  }

  .approach-card h3 {
    margin-bottom: var(--space-sm);
  }

  .approach-card p {
    color: var(--color-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  /* Credentials */
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-xl);
  }

  .credential-group {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .credential-group h3 {
    margin-bottom: var(--space-md);
    font-size: 1.125rem;
    color: var(--color-primary);
  }

  .credential-group ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .credential-group li {
    position: relative;
    padding-left: var(--space-lg);
    color: var(--color-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .credential-group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cta);
  }

  /* CTA */
  .cta-section h2 {
    margin-bottom: var(--space-md);
  }

  .cta-description {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: var(--space-xl);
    font-size: 1.125rem;
    max-width: 500px;
    margin-inline: auto;
  }

  .cta-button {
    font-size: 1.0625rem;
    padding: 14px 32px;
  }
</style>
