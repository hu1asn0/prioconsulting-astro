        <dt>Mailing address</dt>
        <dd>1108 Budapest, Bányató u. 26, 6 em./27, Hungary</dd>

        <dt>Managing director</dt>
        <dd>András Simon</dd>

        <dt>Email</dt>
        <dd><a class="obf-email" href="#">…</a></dd>
      </dl>

      <h2>Bank Details</h2>
      <dl class="legal-details">
        <dt>Bank</dt>
        <dd>K&H Bank</dd>

        <dt>Account number</dt>
        <dd>1040 0157 5052 6983 8272 1006</dd>

        <dt>IBAN</dt>
        <dd>HU21 1040 0157 5052 6983 8272 1006</dd>

