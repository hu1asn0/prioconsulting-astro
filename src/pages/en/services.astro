---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { SITE_URL } from '../../data/schema';

const services = [
  {
    name: 'IT Project Management',
    description: 'Professional management of enterprise IT projects from planning to successful go-live. SAP IS-U / ECC / S/4HANA migrations, CRM and ERP rollouts, Agile and Waterfall methodologies.',
    serviceType: 'IT Project Management',
    slug: 'it-project-management',
  },
  {
    name: 'Automation Projects',
    description: 'Business process automation across workflow, AI integration, and reporting. Saves time and cost for your organization.',
    serviceType: 'Business Process Automation',
    slug: 'automation',
  },
  {
    name: 'Mentoring & Coaching',
    description: 'Tailored development for IT project managers: individual coaching, stakeholder management, team mentoring.',
    serviceType: 'IT Project Management Coaching',
    slug: 'mentoring',
  },
];

const servicesSchema = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE_URL}/en/services/#${s.slug}`,
  name: s.name,
  description: s.description,
  serviceType: s.serviceType,
  provider: { '@id': `${SITE_URL}#business` },
  areaServed: { '@type': 'Country', name: 'Hungary' },
  inLanguage: 'en',
  url: `${SITE_URL}/en/services/`,
}));
---

<Layout
  title="Services | Prio Consulting"
  description="IT Project Management, Automation, and Mentoring services. Experienced consulting for enterprise projects."
  lang="en"
  pageSchema={servicesSchema}
>
  <Hero
    title="Our Services"
    subtitle="Comprehensive IT project management solutions to support your organization's digital transformation."
  />

  <!-- IT Project Management -->
  <section class="section section-light">
    <div class="container service-detail">
      <div class="service-detail-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </div>
      <h2>IT Project Management</h2>
      <p class="service-detail-lead">Professional management of enterprise IT projects from planning to successful delivery.</p>
      <div class="service-features">
        <div class="feature">
          <h3>SAP Migrations</h3>
          <p>Full lifecycle management of SAP S/4HANA migration projects. Risk management, timeline optimization, and stakeholder communication.</p>
        </div>
        <div class="feature">
          <h3>CRM Implementation</h3>
          <p>Coordination of CRM system deployments. From business requirements through to user adoption.</p>
        </div>
        <div class="feature">
          <h3>ERP Projects</h3>
          <p>Management of enterprise resource planning system implementations and upgrades. Process optimization and change management.</p>
        </div>
        <div class="feature">
          <h3>Agile & Waterfall Methodologies</h3>
          <p>Flexible approach: pure Agile, Waterfall, or hybrid methodologies applied according to the nature of the project.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Automation -->
  <section class="section section-surface">
    <div class="container service-detail">
      <div class="service-detail-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
      </div>
      <h2>Automation Projects</h2>
      <p class="service-detail-lead">Business process automation that saves time and reduces costs for your organization.</p>
      <div class="service-features">
        <div class="feature">
          <h3>Workflow Automation</h3>
          <p>Identification and automation of repetitive tasks. Integration with existing systems, APIs, and iPaaS solutions.</p>
        </div>
        <div class="feature">
          <h3>AI Integrations</h3>
          <p>Design and integration of AI solutions into existing business processes. Chatbots, document processing, predictive analytics.</p>
        </div>
        <div class="feature">
          <h3>Reporting Automation</h3>
          <p>Automated report generation, dashboards, and monitoring systems. Data-driven decision support.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mentoring -->
  <section class="section section-light">
    <div class="container service-detail">
      <div class="service-detail-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <h2>Mentoring & Coaching</h2>
      <p class="service-detail-lead">Personalized development and support for IT project managers.</p>
      <div class="service-features">
        <div class="feature">
          <h3>Individual Coaching</h3>
          <p>Tailored coaching programs for IT project managers. Leadership skills, time management, conflict resolution.</p>
        </div>
        <div class="feature">
          <h3>Stakeholder Management</h3>
          <p>Mastering effective stakeholder communication and expectation management techniques. Hands-on workshops.</p>
        </div>
        <div class="feature">
          <h3>Team Mentoring</h3>
          <p>Project team development, team building, preparation for agile ceremonies. Retrospective facilitation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-dark cta-section">
    <div class="container text-center">
      <h2>Interested in our services?</h2>
      <p class="cta-desc">Get in touch for a free consultation.</p>
      <a href="/en/contact/" class="btn-primary">
        Get in touch
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  .service-detail {
    max-width: 800px;
  }

  .service-detail-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(202, 138, 4, 0.1);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-cta);
  }

  .service-detail h2 {
    margin-bottom: var(--space-md);
  }

  .service-detail-lead {
    font-size: 1.25rem;
    color: var(--color-secondary);
    margin-bottom: var(--space-2xl);
    line-height: 1.6;
  }

  .service-features {
    display: grid;
    gap: var(--space-xl);
  }

  .feature h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .feature p {
    color: var(--color-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  .cta-section h2 {
    margin-bottom: var(--space-md);
  }

  .cta-desc {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: var(--space-xl);
    font-size: 1.125rem;
  }
</style>
