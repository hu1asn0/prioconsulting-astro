---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { fetchPosts, formatDate } from '../../lib/beehiiv.js';

const posts = await fetchPosts();
---

<Layout
  title="Blog | Prio Consulting"
  description="IT Project Management blog — articles, case studies, and practical tips."
  lang="en"
>
  <Hero
    title="Blog"
    subtitle="Insights, experiences, and practical advice from the world of IT project management."
  />

  <section class="section section-light">
    <div class="container">
      {posts.length === 0 ? (
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
          <p>Articles coming soon. Subscribe to our newsletter!</p>
        </div>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card">
              {post.image && (
                <div class="blog-card-image">
                  <img src={post.image} alt={post.title} loading="lazy" />
                </div>
              )}
              <div class="blog-card-content">
                <time class="blog-card-date" datetime={new Date(post.pubDate).toISOString()}>
                  {formatDate(post.pubDate, 'en')}
                </time>
                <h2 class="blog-card-title">
                  <a href={`/en/blog/${post.slug}/`}>{post.title}</a>
                </h2>
                <p class="blog-card-excerpt">{post.description}</p>
                <a href={`/en/blog/${post.slug}/`} class="blog-card-link">
                  Read more
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-xl);
  }

  .blog-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .blog-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    border-color: rgba(202, 138, 4, 0.3);
  }

  .blog-card-image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .blog-card:hover .blog-card-image img {
    transform: scale(1.03);
  }

  .blog-card-content {
    padding: var(--space-xl);
  }

  .blog-card-date {
    font-size: 0.875rem;
    color: var(--color-text-light);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .blog-card-title {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .blog-card-title a {
    text-decoration: none;
    color: var(--color-primary);
    cursor: pointer;
  }

  .blog-card-title a:hover {
    color: var(--color-cta);
  }

  .blog-card-excerpt {
    font-size: 0.9375rem;
    color: var(--color-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .blog-card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-cta);
    text-decoration: none;
    cursor: pointer;
    transition: gap var(--transition-base);
  }

  .blog-card-link:hover {
    gap: var(--space-sm);
    color: var(--color-cta-hover);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--color-text-light);
  }

  .empty-state svg {
    margin-inline: auto;
    margin-bottom: var(--space-md);
    color: var(--color-cta);
  }

  .empty-state p {
    font-size: 1.125rem;
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
