---
import Layout from '../../layouts/Layout.astro';
import InstructionHome, { type HomeCopy } from '../../components/InstructionHome.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { SITE_URL } from '../../data/schema';

const faqItems = [
  {
    question: 'What types of projects do you support?',
    answer: 'SAP, CRM, ERP migrations, digital transformation projects, IT infrastructure upgrades, and any enterprise IT project requiring experienced project management.',
  },
  {
    question: 'How does the engagement process work?',
    answer: 'We start with a free consultation to understand your needs. Then we return with a detailed project plan including timelines, milestones, and a proposal.',
  },
  {
    question: 'When should I bring in an external PM?',
    answer: 'Generally, for projects longer than 3 months, involving multiple teams, or of strategic importance, it is worth engaging an experienced external project manager to ensure independent, objective leadership.',
  },
  {
    question: 'Which industries do you serve?',
    answer: 'We have over 15 years of experience in energy, finance, manufacturing, and service sectors. Our clients include both large enterprises and SMEs.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE_URL}/en/#faq`,
  inLanguage: 'en',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const copy: HomeCopy = {
  lang: 'en',
  stepWord: 'step',
  hero: {
    title: 'Your programme already stands. One of its pieces is still missing.',
    lead: 'Applied AI IT PM: the piece that fits artificial intelligence into the enterprise programme you already run. Behind it stand fifteen years of SAP, energy and banking programme leadership, and AI systems of my own running in production.',
    ctaLabel: 'Request an assessment',
    ctaHref: '/en/contact/',
    drawingAlt: 'Drawing: the enterprise programme’s bricks in ghost outline (SAP IS-U, ERP, CRM, data warehouse) with one empty seat; the red “Applied AI IT PM” brick drops along an arrow into place.',
  },
  callout: { name: 'András Simon', role: 'Applied AI IT PM', years: '15 years', company: 'Prio Consulting Kft.', scaleLabel: '1:1', partsLabel: 'Pieces in this set' },
  programBlocks: ['SAP IS-U', 'ERP', 'CRM', 'Data warehouse'],
  pieceLabel: 'Applied AI IT PM',
  stepsHeading: 'How it fits into place',
  steps: [
    { title: 'Assessment', label: 'Assessment', time: '2–3 weeks', body: 'We walk through the candidate processes and look for where the real repetitive burden sits. We record today’s time spent and error rate, map the data sources, and clarify the data protection constraints. The output is a ranked list of what is worth doing first, and what is not worth doing at all.' },
    { title: 'Pilot', label: 'Pilot', time: '6–8 weeks', body: 'The smallest working solution is built for a single process, on real data, with real users. The evaluation set is created, and we measure answer quality, runtime and cost. The output is a running system and a decision pack: a numbers-backed answer on whether it goes into production.' },
    { title: 'Production', label: 'Production', time: '8–12 weeks', body: 'The pilot turns into an operable system: integration with the existing landscape, permissions, logging, backups, monitoring and alerts. We write the operations manual and prepare the users. This is where it becomes clear that the working instructions around the process need adjusting too.' },
    { title: 'Handover', label: 'Handover', time: '4–6 weeks', body: 'Your team takes over operations and I stay behind them for a while. Joint incident handling, training on how to maintain the evaluation set, naming an owner for the budget. The goal is that the system keeps working once I am no longer on the project.' },
  ],
  inventory: {
    heading: 'Pieces in this set',
    note: 'What I can build into your programme.',
    items: [
      { title: 'IT project management', body: 'Professional management of SAP, CRM, and ERP migrations. Agile and waterfall methodologies, risk management, resource planning.', href: '/en/services/', linkLabel: 'Services' },
      { title: 'Applied AI', body: 'Bringing AI into enterprise processes with project discipline: assessment, pilot, production, handover. Behind the method stand scheduled AI systems running on my own servers.', href: '/en/applied-ai/', linkLabel: 'Applied AI service' },
      { title: 'Automation', body: 'Business process automation, workflow optimization, AI integration design and implementation.' },
      { title: 'Mentoring', body: 'Personalized coaching programs for IT project managers. Leadership skills, stakeholder management.' },
    ],
  },
  builds: {
    heading: 'Built from this',
    note: 'Programmes I have worked in.',
    groups: [
      { sector: 'Energy', names: ['MVM', 'E.ON', 'OPUS TITÁSZ', 'MOL'] },
      { sector: 'Finance and insurance', names: ['Allianz', 'PPF'] },
      { sector: 'Industry and manufacturing', names: ['Beck&Pollitzer', 'Kienle+Spiess', 'FlexLink', 'SANYO'] },
    ],
  },
  quote: {
    heading: 'A remarkable note from the back cover page',
    items: [
      {
        quote: 'Thanks for everything, I really liked working with you: even if you were an IT project manager, you fully captured the most important business points of the project, did not get lost in technical details, still you wanted to understand the main targets of the project and drive the whole story to the right way in line with the key stakeholders\' expectations. You really stood out considering my previous experiences.',
        company: 'MOL Hungary Ltd.',
        person: 'Máté Gerebenics',
      },
    ],
  },
  faq: { heading: 'Frequently asked questions', items: faqItems },
  faqNote: 'Notes at the back of the book, click to open.',
  closing: {
    title: 'Start with step 1',
    body: 'An assessment shows where AI fits your processes, and where it is not worth forcing.',
    ctaLabel: 'Request an assessment',
    ctaHref: '/en/contact/',
  },
};
---

<Layout
  title="Prio Consulting | Applied AI IT Project Management"
  description="Applied AI IT project management from Prio Consulting: bringing artificial intelligence into enterprise programmes, with 15 years of SAP, energy and banking programme leadership."
  lang="en"
  pageSchema={faqSchema}
>
  <InstructionHome copy={copy} />
  <NewsletterSignup lang="en" />
</Layout>
