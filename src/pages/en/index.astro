---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Testimonial from '../../components/Testimonial.astro';
import FAQ from '../../components/FAQ.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const faqItems = [
  {
    question: 'What types of projects do you support?',
    answer: 'SAP, CRM, ERP migrations, digital transformation projects, IT infrastructure upgrades, and any enterprise IT project requiring experienced project management.',
  },
  {
    question: 'How does the engagement process work?',
    answer: 'We start with a free consultation to understand your needs. Then we return with a detailed project plan including timelines, milestones, and a proposal.',
  },
  {
    question: 'When should I bring in an external PM?',
    answer: 'Generally, for projects longer than 3 months, involving multiple teams, or of strategic importance, it is worth engaging an experienced external project manager to ensure independent, objective leadership.',
  },
  {
    question: 'Which industries do you serve?',
    answer: 'We have over 15 years of experience in energy, finance, manufacturing, and service sectors. Our clients include both large enterprises and SMEs.',
  },
];

const iconPM = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>';
const iconAuto = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>';
const iconMentor = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>';
---

<Layout
  title="Prio Consulting | Strategic IT Project Management"
  description="Prio Consulting — Strategic IT Project Management and consulting. 15+ years of experience leading enterprise IT projects."
  lang="en"
>
  <Hero
    title="Strategic IT Project Management"
    subtitle="Experienced IT project management consulting that ensures the successful delivery of your projects — on time, on budget, and to the expected quality."
    ctaText="Request a quote"
    ctaLink="/en/contact/"
  />

  <!-- Services Section -->
  <section class="section section-light">
    <div class="container">
      <h2 class="text-center section-heading">Our Services</h2>
      <p class="section-subtitle text-center">Comprehensive IT project management solutions for your organization</p>
      <div class="services-grid">
        <ServiceCard
          title="IT Project Management"
          description="Professional management of SAP, CRM, and ERP migrations. Agile and waterfall methodologies, risk management, resource planning."
          icon={iconPM}
        />
        <ServiceCard
          title="Automation"
          description="Business process automation, workflow optimization, AI integration design and implementation."
          icon={iconAuto}
        />
        <ServiceCard
          title="Mentoring"
          description="Personalized coaching programs for IT project managers. Leadership skills, stakeholder management."
          icon={iconMentor}
        />
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="section section-dark stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item" data-stat>
          <div class="stat-value"><span class="stat-number" data-target="15">0</span><span class="stat-suffix">+</span></div>
          <span class="stat-label">years experience</span>
        </div>
        <div class="stat-item" data-stat>
          <div class="stat-value"><span class="stat-number" data-target="50">0</span><span class="stat-suffix">+</span></div>
          <span class="stat-label">successful projects</span>
        </div>
        <div class="stat-item" data-stat>
          <div class="stat-value"><span class="stat-number" data-target="100">0</span><span class="stat-suffix">%</span></div>
          <span class="stat-label">client satisfaction</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial Section -->
  <section class="section section-surface">
    <div class="container">
      <h2 class="text-center section-heading">What our clients say</h2>
      <p class="section-subtitle text-center">Feedback from our partners about working together</p>
      <Testimonial
        items={[
          {
            quote: "The Prio Consulting team brought outstanding expertise and project management capabilities to our SAP migration project. The collaboration ran smoothly, and the project was delivered on time and within budget.",
            company: "MOL Hungary",
            person: "K. Peter",
            role: "IT Director",
          },
          {
            quote: "During our automation project, Prio Consulting excelled not only in technical delivery but also in change management. The team adapted quickly to our needs and communicated proactively throughout.",
            company: "OTP Bank",
            person: "N. Agnes",
            role: "Head of Digitalization",
          },
          {
            quote: "The mentoring program had a tremendous impact on our project managers' development. Through individual coaching and hands-on workshops, our team now handles complex projects with greater confidence.",
            company: "Richter Gedeon",
            person: "V. Tamas",
            role: "PMO Lead",
          },
        ]}
      />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-light">
    <div class="container">
      <h2 class="text-center section-heading">Frequently Asked Questions</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-dark cta-section">
    <div class="container text-center">
      <h2>Ready for the next step?</h2>
      <p class="cta-description">Get in touch with us to discuss your project needs.</p>
      <a href="/en/contact/" class="btn-primary cta-button">
        Get in touch
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <NewsletterSignup lang="en" />
</Layout>

<style>
  .section-heading {
    margin-bottom: var(--space-sm);
  }

  .section-subtitle {
    color: var(--color-secondary);
    margin-bottom: var(--space-2xl);
    font-size: 1.125rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
  }

  .stats-section {
    text-align: center;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-2xl);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .stat-value {
    display: flex;
    align-items: baseline;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-cta);
    line-height: 1;
  }

  .stat-suffix {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-cta);
    line-height: 1;
  }

  .stat-label {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .cta-section h2 {
    margin-bottom: var(--space-md);
  }

  .cta-description {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: var(--space-xl);
    font-size: 1.125rem;
    max-width: 500px;
    margin-inline: auto;
  }

  .cta-button {
    font-size: 1.0625rem;
    padding: 14px 32px;
  }
</style>

<script>
  function animateCounters() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const numberEl = entry.target.querySelector('.stat-number') as HTMLElement;
            if (!numberEl) return;
            const target = parseInt(numberEl.dataset.target || '0', 10);
            const duration = 2000;
            const startTime = performance.now();

            function update(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              numberEl.textContent = Math.round(target * eased).toString();
              if (progress < 1) {
                requestAnimationFrame(update);
              }
            }

            requestAnimationFrame(update);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    document.querySelectorAll('[data-stat]').forEach((el) => observer.observe(el));
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    animateCounters();
  } else {
    document.querySelectorAll('.stat-number').forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.textContent = htmlEl.dataset.target || '0';
    });
  }
</script>
