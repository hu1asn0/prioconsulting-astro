---
import Layout from '../../layouts/Layout.astro';
import { fetchPosts, formatDate } from '../../lib/beehiiv.js';

export async function getStaticPaths() {
  const posts = await fetchPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout
  title={`${post.title} | Prio Consulting Blog`}
  description={post.description}
  lang="hu"
>
  <article class="blog-post">
    <header class="blog-post-header section-dark">
      <div class="container">
        <a href="/blog/" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Vissza a bloghoz
        </a>
        <h1>{post.title}</h1>
        <div class="blog-post-meta">
          <time datetime={new Date(post.pubDate).toISOString()}>
            {formatDate(post.pubDate, 'hu')}
          </time>
          {post.author && <span class="meta-separator">|</span>}
          {post.author && <span>{post.author}</span>}
        </div>
      </div>
    </header>

    {post.image && (
      <div class="blog-post-hero-image container">
        <img src={post.image} alt={post.title} />
      </div>
    )}

    <div class="container">
      <div class="blog-content" set:html={post.content} />
    </div>

    <div class="container blog-post-footer">
      <a href="/blog/" class="btn-secondary blog-back-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Osszes cikk
      </a>
    </div>
  </article>
</Layout>

<style>
  .blog-post-header {
    padding: var(--space-3xl) 0 var(--space-2xl);
    background: var(--color-primary);
    color: var(--color-white);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9375rem;
    margin-bottom: var(--space-xl);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--transition-base);
  }

  .back-link:hover {
    color: var(--color-cta);
  }

  .blog-post-header h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
    max-width: 800px;
  }

  .blog-post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9375rem;
  }

  .meta-separator {
    opacity: 0.4;
  }

  .blog-post-hero-image {
    margin-top: calc(-1 * var(--space-xl));
    margin-bottom: var(--space-2xl);
    max-width: 800px;
  }

  .blog-post-hero-image img {
    border-radius: var(--radius-lg);
    width: 100%;
    box-shadow: var(--shadow-lg);
  }

  .blog-content {
    max-width: 800px;
    padding-block: var(--space-2xl);
  }

  .blog-post-footer {
    padding-block: var(--space-2xl);
    max-width: 800px;
  }

  .blog-back-btn {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .blog-back-btn:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }
</style>
