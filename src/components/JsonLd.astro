---
interface Props {
  data: object | object[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];

// `</script>` substring escape a JSON value-kban (HTML-injection védelem).
const safeJson = (item: object) =>
  JSON.stringify(item).replace(/<\/script/gi, '<\\/script');
---
{items.map((item) => (
  <script type="application/ld+json" set:html={safeJson(item)}></script>
))}
