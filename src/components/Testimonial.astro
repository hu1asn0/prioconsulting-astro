---
interface TestimonialItem {
  quote: string;
  company: string;
  person: string;
  role?: string;
}

interface Props {
  quote?: string;
  company?: string;
  person?: string;
  role?: string;
  items?: TestimonialItem[];
}

const { quote, company, person, role, items } = Astro.props;

// Support both single testimonial (backward compat) and multiple
const testimonials: TestimonialItem[] = items
  ? items
  : (quote && company && person)
    ? [{ quote, company, person, role }]
    : [];
---

<div class:list={['testimonial-grid', { 'testimonial-single': testimonials.length === 1 }]}>
  {testimonials.map((t) => (
    <blockquote class="testimonial">
      <div class="testimonial-quote-icon" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
      </div>
      <p class="testimonial-text">{t.quote}</p>
      <footer class="testimonial-footer">
        <div class="testimonial-author">
          <span class="testimonial-person">{t.person}</span>
          <span class="testimonial-role">{[t.role, t.company].filter(Boolean).join(', ')}</span>
        </div>
      </footer>
    </blockquote>
  ))}
</div>

<style>
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-xl);
    max-width: 1000px;
    margin-inline: auto;
  }
  .testimonial-single {
    max-width: 720px;
  }
  .testimonial {
    background: transparent;
    border: var(--keyline);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .testimonial-quote-icon {
    color: var(--color-piece);
    margin-bottom: var(--space-md);
  }
  .testimonial-text {
    font-size: 1.125rem;
    color: var(--color-ink);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    flex: 1;
    max-width: 65ch;
  }
  .testimonial-footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: var(--keyline-thin);
  }
  .testimonial-author {
    display: flex;
    flex-direction: column;
  }
  .testimonial-person {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-ink);
    font-size: 1rem;
  }
  .testimonial-role {
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }
</style>
