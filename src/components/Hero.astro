---
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { title, subtitle, ctaText, ctaLink } = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-gradient-1"></div>
    <div class="hero-gradient-2"></div>
  </div>
  <div class="container hero-content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {ctaText && ctaLink && (
      <a href={ctaLink} class="btn-primary hero-cta">
        {ctaText}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-page);
    color: var(--color-ink);
    padding: var(--space-3xl) 0;
    min-height: 40vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg { display: none; }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }
  .hero-title {
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: -0.02em;
    padding-bottom: var(--space-md);
    border-bottom: var(--keyline);
  }
  .hero-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--color-ink-soft);
    max-width: 60ch;
    margin-bottom: var(--space-2xl);
    line-height: 1.5;
  }
  .hero-cta {
    font-size: 1.0625rem;
    padding: 14px 28px;
  }
  @media (min-width: 768px) {
    .hero {
      padding: var(--space-3xl) 0;
      min-height: 45vh;
    }
  }
</style>
