---
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { title, subtitle, ctaText, ctaLink } = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-gradient-1"></div>
    <div class="hero-gradient-2"></div>
  </div>
  <div class="container hero-content">
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {ctaText && ctaLink && (
      <a href={ctaLink} class="btn-primary hero-cta">
        {ctaText}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-primary);
    color: var(--color-white);
    padding: var(--space-3xl) 0;
    min-height: 40vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-gradient-1 {
    position: absolute;
    top: -30%;
    right: -20%;
    width: 60%;
    height: 120%;
    background: radial-gradient(ellipse, rgba(202, 138, 4, 0.08) 0%, transparent 70%);
  }

  .hero-gradient-2 {
    position: absolute;
    bottom: -40%;
    left: -10%;
    width: 50%;
    height: 100%;
    background: radial-gradient(ellipse, rgba(51, 65, 85, 0.2) 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .hero-title {
    color: var(--color-white);
    margin-bottom: var(--space-lg);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: rgba(255, 255, 255, 0.75);
    max-width: 600px;
    margin-bottom: var(--space-2xl);
    line-height: 1.6;
  }

  .hero-cta {
    font-size: 1.0625rem;
    padding: 14px 32px;
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--space-3xl) 0;
      min-height: 45vh;
    }
  }
</style>
