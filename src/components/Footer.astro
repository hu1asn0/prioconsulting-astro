---
interface Props {
  lang?: string;
}

const { lang = 'hu' } = Astro.props;

const currentYear = new Date().getFullYear();

const links = lang === 'hu'
  ? {
      impressum: { label: 'Impresszum', href: '/impresszum/' },
      privacy: { label: 'Adatvédelem', href: '/adatvedelem/' },
      about: { label: 'Rólam', href: '/rolam/' },
      services: { label: 'Szolgáltatások', href: '/szolgaltatasok/' },
      blog: { label: 'Blog', href: '/blog/' },
      contact: { label: 'Kapcsolat', href: '/kapcsolat/' },
    }
  : {
      impressum: { label: 'Impressum', href: '/en/impressum/' },
      privacy: { label: 'Privacy Policy', href: '/en/privacy/' },
      about: { label: 'About', href: '/en/about/' },
      services: { label: 'Services', href: '/en/services/' },
      blog: { label: 'Blog', href: '/en/blog/' },
      contact: { label: 'Contact', href: '/en/contact/' },
    };

const t = {
  address: 'Wesselényi utca 4., 1077 Budapest',
  email: '',
  nav: lang === 'hu' ? 'Navigáció' : 'Navigation',
  legal: lang === 'hu' ? 'Jogi információk' : 'Legal',
  contactLabel: lang === 'hu' ? 'Kapcsolat' : 'Contact',
  copyright: `${currentYear} Prio Consulting Kft.`,
  rights: lang === 'hu' ? 'Minden jog fenntartva.' : 'All rights reserved.',
};
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={lang === 'hu' ? '/' : '/en/'} class="footer-logo">PRIO CONSULTING</a>
      <p class="footer-tagline">
        {lang === 'hu'
          ? 'Stratégiai IT Projekt Menedzsment és Tanácsadás'
          : 'Strategic IT Project Management & Consulting'}
      </p>
    </div>

    <div class="footer-column">
      <h3>{t.nav}</h3>
      <ul>
        <li><a href={links.about.href}>{links.about.label}</a></li>
        <li><a href={links.services.href}>{links.services.label}</a></li>
        <li><a href={links.blog.href}>{links.blog.label}</a></li>
        <li><a href={links.contact.href}>{links.contact.label}</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>{t.legal}</h3>
      <ul>
        <li><a href={links.impressum.href}>{links.impressum.label}</a></li>
        <li><a href={links.privacy.href}>{links.privacy.label}</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>{t.contactLabel}</h3>
      <ul>
        <li class="footer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{t.address}</span>
        </li>
        <li class="footer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>info[ at]prioconsulting.hu</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {t.copyright} {t.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-page);
    color: var(--color-ink);
    padding-top: var(--space-3xl);
    border-top: var(--keyline);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    gap: var(--space-2xl);
  }
  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
  .footer-logo {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    color: var(--color-ink);
    letter-spacing: 0.08em;
    border: var(--keyline);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    text-decoration: none;
    cursor: pointer;
    line-height: 1.2;
  }
  .footer-logo:hover { background: var(--color-callout-tint); }
  .footer-tagline {
    margin-top: var(--space-md);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 36ch;
    color: var(--color-ink-soft);
  }
  .footer-column h3 {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: var(--keyline);
  }
  .footer-column ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .footer-column a {
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .footer-column a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .footer-contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 1rem;
  }
  .footer-contact-item svg {
    flex-shrink: 0;
    color: var(--color-ink);
  }
  .footer-bottom p { font-size: 0.9375rem; }
  .footer-bottom {
    margin-top: var(--space-2xl);
    padding-block: var(--space-lg);
    border-top: var(--keyline);
    font-size: 0.9375rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--color-ink-soft);
  }
  .footer-bottom a { color: var(--color-ink); text-decoration: none; }
  .footer-bottom a:hover { text-decoration: underline; }
</style>
