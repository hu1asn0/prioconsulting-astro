---
interface Props {
  lang?: string;
}

const { lang = 'hu' } = Astro.props;
const publicationUrl = 'https://andrs-newsletter-366e2f.beehiiv.com/subscribe';

const t = {
  heading: lang === 'hu' ? 'Iratkozzon fel hírlevelünkre' : 'Subscribe to our newsletter',
  description: lang === 'hu'
    ? 'AI tippek és gyakorlati tanácsok IT-projektmenedzsmenthez — közvetlenül a postaládájába.'
    : 'AI tips and practical advice for IT project management — delivered to your inbox.',
  placeholder: lang === 'hu' ? 'Email cím' : 'Email address',
  button: lang === 'hu' ? 'Feliratkozás' : 'Subscribe',
  note: lang === 'hu' ? 'Nincs spam. Bármikor leiratkozhat.' : 'No spam. Unsubscribe anytime.',
};
---

<section class="newsletter-section section section-dark">
  <div class="container text-center">
    <h2>{t.heading}</h2>
    <p class="newsletter-desc">{t.description}</p>
    <form action={publicationUrl} method="POST" class="signup-form">
      <input
        type="email"
        name="email"
        required
        placeholder={t.placeholder}
        aria-label={t.placeholder}
      />
      <button type="submit">
        {t.button}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>
    <p class="signup-note">{t.note}</p>
  </div>
</section>

<style is:global>
  .newsletter-section h2 {
    margin-bottom: var(--space-md);
  }

  .newsletter-desc {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-xl);
    max-width: 500px;
    margin-inline: auto;
  }

  .signup-form {
    display: flex;
    gap: var(--space-sm);
    max-width: 480px;
    margin-inline: auto;
  }

  .signup-form input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    transition: border-color var(--transition-base);
  }

  .signup-form input:focus {
    outline: none;
    border-color: var(--color-cta);
  }

  .signup-form input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .signup-form button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 12px 24px;
    background: var(--color-cta);
    color: var(--color-primary);
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--transition-base);
  }

  .signup-form button:hover {
    background: var(--color-cta-hover);
  }

  .signup-note {
    margin-top: var(--space-sm);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 480px) {
    .signup-form {
      flex-direction: column;
    }
  }
</style>
